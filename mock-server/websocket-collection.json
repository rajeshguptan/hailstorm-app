{
  "info": {
    "name": "Hailstorm Mock WebSocket",
    "description": "Connect to the local Hailstorm mock WebSocket service. Use ws://127.0.0.1:4010/ws for echo or ws://127.0.0.1:4010/ws/chat for chat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Echo WebSocket",
      "request": {
        "method": "GET",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "ws://127.0.0.1:4010/ws",
          "protocol": "ws",
          "host": ["127.0.0.1"],
          "port": "4010",
          "path": ["ws"]
        }
      }
    },
    {
      "name": "Chat WebSocket",
      "request": {
        "method": "GET",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "ws://127.0.0.1:4010/ws/chat",
          "protocol": "ws",
          "host": ["127.0.0.1"],
          "port": "4010",
          "path": ["ws", "chat"]
        }
      }
    }
  ]
}